# Checkpoints -- 67-210 MB each, ~1 GB total. Never commit these.
*.pt
*.pt.last
*.bin
*.safetensors

# Corpora -- regenerate with fetch_hindi.py / experiments/*.sh, or let train.py
# download tinyshakespeare on first run.
data/
*.txt.gz
*.xml.bz2


__pycache__/
*.py[cod]
.venv/
venv/
.env

.vscode/
.idea/
.DS_Store
Thumbs.db

# Run artefacts from this machine: logs, guard files, editor backups, scratch.
*.log
*.err
*.marker
*.probe250k
*.bak_*
tasks_history.log
golden/*.old.jsonl
release/
logs/

# The demo's password file (the demo says it is ignored; keep it so).
/.demo_auth

# Assistant and editor state from this machine.
/.claude/

# Packaging and tool caches.
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Tokenizers are small and every checkpoint needs its own; ship them. The
# whitelist names them, so stray JSON in data/ (contamination reports, caches)
# cannot be committed by accident.
!data/
data/*
!data/code32k.json
!data/hi16k*.json
!data/multi32k.json
!data/rag_demo_questions.jsonl
sweep/

# Run outputs belong in runs/ or checkpoints/, never at the repository root.
runs/
checkpoints/
/*_curve.csv
/*.jsonl

# The book's HTML/PDF preview is build output (book/tools/build_preview.py).
book/preview/
course/preview/
