{
  "title": "Decide: zero-shot with your own options",
  "method": "POST",
  "path": "/v1/decide",
  "body": {
    "model": "anulm-decide-general",
    "input": [
      "The delivery came two weeks late and the box was crushed",
      "Thank you, the staff were wonderful",
      "Do you ship to Canada?"
