{
  "title": "Chat, streamed (server-sent events)",
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
    "model": "anulm-chat",
    "messages": [
      {
        "role": "user",
        "content": "Write one sentence about the monsoon."
      }
    ],
    "max_tokens": 48,
    "temperature": 0.7,
    "repetition_penalty": 1.3,
    "seed": 7,
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  }
}
