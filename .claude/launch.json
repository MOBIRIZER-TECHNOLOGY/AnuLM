{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app_omni (cpu)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "app_omni.py",
        "--device",
        "cpu",
        "--port",
        "7863"
      ],
      "port": 7863
    },
    {
      "name": "app_omni (lan, cpu)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "app_omni.py",
        "--device",
        "cpu",
        "--port",
        "7863",
        "--host",
        "0.0.0.0"
      ],
      "port": 7863
    },
    {
      "name": "app_omni (lan, cpu, password)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "app_omni.py",
        "--device",
        "cpu",
        "--port",
        "7863",
        "--host",
        "0.0.0.0",
        "--auth-file",
        ".demo_auth"
      ],
      "port": 7863
    },
    {
      "name": "course (static)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "course"
      ],
      "port": 8765
    }
  ]
}